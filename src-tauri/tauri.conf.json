{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EliaukMusic",
  "version": "1.0.0",
  "identifier": "com.eliauk.music",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eliauk 音乐",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* https: http:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost blob: https: http:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Eliauk 音乐",
    "longDescription": "基于 Tauri + Vue 的桌面音乐播放器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
